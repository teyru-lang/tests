  static long crc32(byte[] b) { CRC32 c = new CRC32(); c.update(b); return c.getValue(); }

  static byte[] unhex(String s) {
    byte[] out = new byte[s.length() / 2];
    for (int i = 0; i < out.length; i++) {
      out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);
    }
    return out;
  }

  static byte[] text(int n) {
    String unit = "The quick brown fox jumps over the lazy dog. ";
    byte[] out = new byte[n];
    for (int i = 0; i < n; i++) out[i] = (byte) unit.charAt(i % unit.length());
    return out;
  }

  static byte[] comp(int n) {
    byte[] out = new byte[n];
    for (int i = 0; i < n; i++) out[i] = (byte) ((i % 64) * 3 + (i / 64));
    return out;
  }

  static byte[] rnd(int n) {
    byte[] out = new byte[n];
    int x = 123456789;
    for (int i = 0; i < n; i++) { x = x * 1103515245 + 12345; out[i] = (byte) ((x >>> 16) & 255); }
    return out;
  }

  static byte[] inp(int i) {
    if (i == 0) return new byte[0];
    if (i == 1) return "A".getBytes();
    if (i == 2) return "hello world".getBytes();
    if (i == 3) return text(4000);
    if (i == 4) return comp(65536);
    return rnd(102400);
  }

  static byte[] deflate(byte[] in, int level, boolean nowrap) {
    Deflater d = new Deflater(level, nowrap);
    d.setInput(in);
    d.finish();
    ByteArrayOutputStream bo = new ByteArrayOutputStream();
    byte[] buf = new byte[1 << 20];
    while (!d.finished()) bo.write(buf, 0, d.deflate(buf, 0, buf.length));
    d.end();
    return bo.toByteArray();
  }

  static byte[] inflate(byte[] comp, boolean nowrap) throws DataFormatException {
    Inflater f = new Inflater(nowrap);
    f.setInput(comp);
    ByteArrayOutputStream bo = new ByteArrayOutputStream();
    byte[] buf = new byte[1 << 20];
    while (!f.finished()) { int n = f.inflate(buf, 0, buf.length); if (n == 0) break; bo.write(buf, 0, n); }
    return bo.toByteArray();
  }

  static void tryInflate(String label, byte[] comp, boolean nowrap) {
    try {
      Inflater f = new Inflater(nowrap);
      f.setInput(comp);
      byte[] out = new byte[1 << 16];
      while (!f.finished()) { int n = f.inflate(out, 0, out.length); if (n == 0) break; }
      p(label + " ok finished=" + f.finished());
    } catch (DataFormatException e) {
      p(label + " DataFormatException: " + e.getMessage());
    }
  }

  public static void main(String[] args) throws Exception {
    String[] names = { "EMPTY", "ONE", "HELLO", "TEXT", "COMP" };
    int[] levels = { 0, 1, 6, 9 };

    for (int i = 0; i < 6; i++) {
      byte[] in = inp(i);
      String name = i < 5 ? names[i] : "RAND";
      for (int li = 0; li < 4; li++) {
        for (int w = 0; w < 2; w++) {
          boolean nowrap = w == 0;
          byte[] z = deflate(in, levels[li], nowrap);
          byte[] back = inflate(z, nowrap);
          p("round trip " + name + " lvl=" + levels[li] + " raw=" + nowrap + " " + java.util.Arrays.equals(in, back));
        }
      }
    }

    for (int i = 0; i < 5; i++) {
      for (int li = 0; li < 4; li++) {
        for (int w = 0; w < 2; w++) {
          int at = i * 8 + li * 2 + w;
          if (JAVA_BLOB[at].length() == 0) continue;
          boolean nowrap = w == 0;
          String label = names[i] + " lvl=" + levels[li] + " raw=" + nowrap;
          byte[] jb = inflate(unhex(JAVA_BLOB[at]), nowrap);
          p("java blob  " + label + " " + java.util.Arrays.equals(inp(i), jb) + " crc=" + crc32(jb));
          byte[] tb = inflate(unhex(TEYRU_BLOB[at]), nowrap);
          p("teyru blob " + label + " " + java.util.Arrays.equals(inp(i), tb) + " crc=" + crc32(tb));
        }
      }
    }

    for (int i = 0; i < 5; i++) {
      for (int li = 0; li < 4; li++) {
        for (int w = 0; w < 2; w++) {
          int at = i * 8 + li * 2 + w;
          if (JAVA_BLOB[at].length() == 0) continue;
          boolean nowrap = w == 0;
          String label = names[i] + " lvl=" + levels[li] + " raw=" + nowrap;
          byte[] now = deflate(inp(i), levels[li], nowrap);
          p("this deflater reproduces its blob " + label + " " + java.util.Arrays.equals(unhex(JAVA_BLOB[at]), now));
        }
      }
    }

    for (int i = 0; i < 6; i++) {
      String name = i < 5 ? names[i] : "RAND";
      p("level 0 raw crc  " + name + " " + crc32(deflate(inp(i), 0, true)));
      p("level 0 zlib crc " + name + " " + crc32(deflate(inp(i), 0, false)));
      p("input crc        " + name + " " + crc32(inp(i)));
    }

    tryInflate("bad header", new byte[]{ 0x78, 0x00, 0x03, 0x00 }, false);
    tryInflate("bad method", new byte[]{ 0x00, 0x00, 0x03, 0x00 }, false);
    tryInflate("bad window", new byte[]{ (byte) 0x88, 0x1c, 0x03, 0x00 }, false);
    tryInflate("block type 3", new byte[]{ 0x07 }, true);
    tryInflate("stored nlen", new byte[]{ 0x01, 0x03, 0x00, 0x00, 0x00, 'a', 'b', 'c' }, true);
    byte[] good = deflate("the quick brown fox".getBytes(), 6, false);
    byte[] badAdler = good.clone();
    badAdler[badAdler.length - 1] = (byte) (badAdler[badAdler.length - 1] ^ 1);
    tryInflate("bad adler", badAdler, false);
    tryInflate("truncated", java.util.Arrays.copyOf(good, good.length - 4), false);

    BitWriter v = new BitWriter();
    v.bits(1, 1); v.bits(1, 2);
    v.huff(0x30, 8);
    v.huff(0x01, 7);
    v.huff(30, 5);
    v.huff(0, 7);
    tryInflate("distance code 30", v.done(), true);

    BitWriter w = new BitWriter();
    w.bits(1, 1); w.bits(1, 2);
    w.huff(0x30, 8);
    w.huff(0x01, 7);
    w.huff(29, 5);
    w.bits(0, 13);
    w.huff(0, 7);
    tryInflate("distance too far back", w.done(), true);

    BitWriter q = new BitWriter();
    q.bits(1, 1); q.bits(2, 2);
    q.bits(0, 5); q.bits(31, 5); q.bits(0, 4);
    for (int i = 0; i < 4; i++) q.bits(0, 3);
    tryInflate("too many symbols", q.done(), true);

    BitWriter o = new BitWriter();
    o.bits(1, 1); o.bits(2, 2);
    o.bits(0, 5); o.bits(0, 5); o.bits(15, 4);
    for (int i = 0; i < 19; i++) o.bits(1, 3);
    tryInflate("oversubscribed lengths", o.done(), true);

    p("done");
  }
}

final class BitWriter {
  private byte[] buf = new byte[64];
  private int len = 0;
  private int cur = 0;
  private int bits = 0;

  public void bits(int value, int n) {
    for (int i = 0; i < n; i++) {
      cur = cur | (((value >>> i) & 1) << bits);
      bits++;
      if (bits == 8) flush();
    }
  }

  public void huff(int value, int n) {
    int r = 0;
    for (int i = 0; i < n; i++) r = (r << 1) | ((value >>> i) & 1);
    bits(r, n);
  }

  private void flush() {
    if (len == buf.length) {
      byte[] bigger = new byte[buf.length << 1];
      System.arraycopy(buf, 0, bigger, 0, len);
      buf = bigger;
    }
    buf[len] = (byte) cur;
    len++;
    cur = 0;
    bits = 0;
  }

  public byte[] done() {
    if (bits > 0) flush();
    return java.util.Arrays.copyOf(buf, len);
  }
}
