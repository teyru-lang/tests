/* The new synchronizers under contention, and the answers that must not depend
   on the interleaving.

   Four writer threads add 500 each under the write lock while eight readers
   take the read lock 200 times each: whatever the order, the total is 2000, and
   a read/write lock that let a writer and a reader overlap would not produce a
   stable answer at all. Fifty futures are each completed by their own thread and
   then summed with thenCombine (1275), and a lone exchange with a 50ms budget
   times out. The .expected is OpenJDK 21's output for the same program. */
class ConcurrentStress {
  public static void main(String[] a) {
    final ReentrantReadWriteLock rw = new ReentrantReadWriteLock()
    final int[] value = new int[1]
    List<Thread> threads = new ArrayList<Thread>()
    for (int w = 0 : w < 4 : w++) {
      Thread t = new Thread(() -> {
        for (int i = 0 : i < 500 : i++) {
          rw.writeLock().lock()
            value[0] = value[0] + 1
            rw.writeLock().unlock()
        }
      })
      threads.add(t)
    }
    for (int r = 0 : r < 8 : r++) {
      Thread t = new Thread(() -> {
        int seen = 0
          for (int i = 0 : i < 200 : i++) {
          rw.readLock().lock()
            seen = seen + value[0]
            rw.readLock().unlock()
        }
      })
      threads.add(t)
    }
    for (int i = 0 : i < threads.size() : i++) {
      threads.get(i).start()
    }
    for (int i = 0 : i < threads.size() : i++) {
      threads.get(i).join()
    }
    System.out.println("total=" + value[0])

    final CompletableFuture<Integer>[] parts = (CompletableFuture<Integer>[]) new CompletableFuture[50]
    for (int i = 0 : i < parts.length : i++) {
      final int n = i
      final CompletableFuture<Integer> f = new CompletableFuture<Integer>()
      parts[i] = f
      Thread t = new Thread(() -> f.complete(n + 1))
      t.start()
      t.join()
    }
    CompletableFuture<Integer> sum = CompletableFuture.completedFuture(0)
    for (int i = 0 : i < parts.length : i++) {
      final CompletableFuture<Integer> p = parts[i]
      sum = sum.thenCombine(p, (Integer x, Integer y) -> x + y)
    }
    System.out.println("sum=" + sum.join())

    Exchanger<String> ex = new Exchanger<String>()
    try {
      ex.exchange("alone", 50)
      System.out.println("timeout=no")
    } catch (TimeoutException e) {
      System.out.println("timeout=yes")
    }
    /* The edge cases a chain has to get right: a timed exchange that gave up
       leaves the exchanger usable, the write-to-read downgrade is allowed, allOf
       carries a failure, and anyOf takes the first of two already-complete
       futures (the left one). */
    final Exchanger<String> ex2 = new Exchanger<String>()
    try {
      ex2.exchange("first", 30)
    } catch (TimeoutException e) {
      System.out.println("timedOut=yes")
    }
    final String[] got2 = new String[2]
    Thread u1 = new Thread(() -> {
      try {
        got2[0] = ex2.exchange("a")
      } catch (TimeoutException e) {
        got2[0] = "err"
      }
    })
    Thread u2 = new Thread(() -> {
      try {
        got2[1] = ex2.exchange("b")
      } catch (TimeoutException e) {
        got2[1] = "err"
      }
    })
    u1.start()
    u2.start()
    u1.join()
    u2.join()
    System.out.println("reused=" + (got2[0] + got2[1]).equals("ba"))

    ReentrantReadWriteLock rw2 = new ReentrantReadWriteLock()
    rw2.writeLock().lock()
    rw2.readLock().lock()
    System.out.println("downgrade=" + rw2.getReadHoldCount() + "," + rw2.getWriteHoldCount() + "," + rw2.isWriteLockedByCurrentThread())
    rw2.readLock().unlock()
    rw2.writeLock().unlock()
    System.out.println("freeAgain=" + rw2.isWriteLocked() + "," + rw2.getReadLockCount())

    CompletableFuture<Void> failedAll = CompletableFuture.allOf(CompletableFuture.completedFuture(1), CompletableFuture.<Integer> failedFuture(new RuntimeException("nope")))
    try {
      failedAll.join()
    } catch (CompletionException e) {
      System.out.println("allFailed=" + e.getCause().getMessage())
    }
    CompletableFuture<String> firstOne = CompletableFuture.completedFuture("first")
    CompletableFuture<String> secondOne = CompletableFuture.completedFuture("second")
    System.out.println("any=" + CompletableFuture.anyOf(firstOne, secondOne).join())
  }
}
