/* The same program in Java, which is where t192_index_out_of_bounds.expected
   comes from:
     javac -d /tmp OobIdiom.java && java -cp /tmp OobIdiom
   (the file is named after its public class; rename it to match when re-running) */
public class OobIdiom {
  static void op(int i) {
    if (i == 0) {
      char c = "abc".charAt(9);;
    }
    else if (i == 1) {
      String s = "abc".substring(9);;
    }
    else if (i == 2) {
      String s = "abc".substring(2, 1);;
    }
    else if (i == 3) {
      String s = "abc".substring(0, 4);;
    }
    else if (i == 4) {
      char c = new StringBuilder("abc").charAt(9);;
    }
    else if (i == 5) {
      String s = new StringBuilder("abc").substring(9);;
    }
    else if (i == 6) {
      new StringBuilder("abc").setLength(-1);;
    }
    else if (i == 7) {
      int[] a = new int[1];
      int v = a[2];;
    }
    else if (i == 8) {
      int[] a = new int[1];
      a[-1] = 1;;
    }
    else if (i == 9) {
      char[] cs = new char[2];
      String s = String.valueOf(cs, 0, 3);;
    }
    else if (i == 10) {
      char c = "abc".charAt(2);;
    }
  }

  static String kind(int i) {
    try {
      op(i);
      return "no-throw";
    } catch (StringIndexOutOfBoundsException e) {
      return "StringIndexOutOfBounds";
    } catch (ArrayIndexOutOfBoundsException e) {
      return "ArrayIndexOutOfBounds";
    } catch (IndexOutOfBoundsException e) {
      return "IndexOutOfBounds";
    }
  }

  public static void main(String[] args) {
    String[] names = { "charAt", "substring", "substring2", "substringPast", "sbCharAt", "sbSubstring", "sbSetLength", "arrayRead", "arrayWrite", "valueOfChars", "inRange" };
    for (int i = 0; i < names.length; i++) {
      System.out.println(names[i] + " " + kind(i));
    }
  }
}
