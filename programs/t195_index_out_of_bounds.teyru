/* Java's indexing exceptions, caught the way a Java program catches them: by
 * the parent type. The three have the hierarchy java.lang gives them --
 * IndexOutOfBoundsException, with an array's and a String's below it -- so a
 * catch of the parent takes whichever arrived, and a catch of the array one
 * does not take a String's. Which of the three arrived is printed by the catch
 * that took it, so no class name is printed and the expectation is javac's
 * output. `inRange` is the line that says nothing was thrown when nothing was
 * wrong.
 *
 * The expectation is the same program compiled by javac:
 *   javac -d /tmp OobIdiom.java && java -cp /tmp OobIdiom     (see the .java.ref) */
class Main {
  static void op(int i) {
    if (i == 0) {
      char c = "abc".charAt(9)
    }
    else if (i == 1) {
      String s = "abc".substring(9)
    }
    else if (i == 2) {
      String s = "abc".substring(2, 1)
    }
    else if (i == 3) {
      String s = "abc".substring(0, 4)
    }
    else if (i == 4) {
      char c = new StringBuilder("abc").charAt(9)
    }
    else if (i == 5) {
      String s = new StringBuilder("abc").substring(9)
    }
    else if (i == 6) {
      new StringBuilder("abc").setLength(-1)
    }
    else if (i == 7) {
      int[] a = new int[1]
      int v = a[2]
    }
    else if (i == 8) {
      int[] a = new int[1]
      a[-1] = 1
    }
    else if (i == 9) {
      char[] cs = new char[2]
      String s = String.valueOf(cs, 0, 3)
    }
    else if (i == 10) {
      char c = "abc".charAt(2)
    }
  }

  static String kind(int i) {
    try {
      op(i)
      return "no-throw"
    } catch (StringIndexOutOfBoundsException e) {
      return "StringIndexOutOfBounds"
    } catch (ArrayIndexOutOfBoundsException e) {
      return "ArrayIndexOutOfBounds"
    } catch (IndexOutOfBoundsException e) {
      return "IndexOutOfBounds"
    }
  }

  public static void main(String[] args) {
    String[] names = new String[11]
    names[0] = "charAt"
    names[1] = "substring"
    names[2] = "substring2"
    names[3] = "substringPast"
    names[4] = "sbCharAt"
    names[5] = "sbSubstring"
    names[6] = "sbSetLength"
    names[7] = "arrayRead"
    names[8] = "arrayWrite"
    names[9] = "valueOfChars"
    names[10] = "inRange"
    for (int i = 0 : i < names.length : i++) {
      System.out.println(names[i] + " " + kind(i))
    }
  }
}
