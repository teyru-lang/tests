/* The bitwise compound assignments on a boxed target: `Integer a = 5; a &= 3`
 * is `a = Integer.valueOf(((int) a.intValue()) & 3)` (JLS 15.26.2 with 5.1.8).
 *
 * Neither back end unboxes the target here, and this is where that shows as a
 * refusal rather than as a wrong answer. The LLVM back end emits the operator
 * against the reference itself -- `and ptr %t11, %t16` -- which is not valid
 * LLVM IR, so the module does not verify and the driver reports it with its own
 * message that this is a bug in the back end and not a limit of it. The C back
 * end emits `(*p) &= 3` on a `C_teyru_Integer *`, which clang and gcc both
 * reject ("invalid operands to binary expression").
 *
 * The arithmetic spellings of the same gap are t246 (there the C back end is
 * the one that is wrong) and the shift spellings are t248.
 *
 * The expectation is the same program compiled by javac 21:
 *   javac -d /tmp t247_probe_boxed_bitwise.java && java -cp /tmp Main
 *   (see the .java.ref) */
import teyru.*

class Main {
  static Integer S = 5

  static void p(String k, Object v) {
    System.out.println(k + " = " + v)
  }

  public static void main(String[] args) {
    Integer a = 5
    a &= 3
    p("Integer &= 3", a)
    Integer b = 5
    b |= 2
    p("Integer |= 2", b)
    Integer c = 5
    c ^= 3
    p("Integer ^= 3", c)
    Integer d = -1
    d &= 15
    p("Integer -1 &= 15", d)

    Long e = 3L
    e &= 1L
    p("Long &= 1L", e)
    Long f = 1L
    f |= 2L
    p("Long |= 2L", f)
    Long g = 3L
    g ^= 1L
    p("Long ^= 1L", g)
    Long h = 4294967296L
    h &= 4294967296L
    p("Long &= past 32 bits", h)

    // a static field target
    S &= 3
    p("static Integer &= 3", S)
  }
}
