/* Thread.State: the six answers, each in the situation that produces it.

   NEW before start, TIMED_WAITING inside Thread.sleep, WAITING inside
   Object.wait, BLOCKED queueing for a monitor another thread holds, and
   TERMINATED after join. The three blocking states are found by polling with a
   two-second bound rather than by reading a clock: the test asserts that the
   state was observed, and the .expected is OpenJDK 21's run of the same
   program, so a state the runtime never reports shows up as false. */
class ThreadStates {
  static class Sleeper implements Runnable {
    public void run() {
      try {
        Thread.sleep(300)
      } catch (InterruptedException e) {}
    }
  }

  static boolean poll(Thread t, Thread.State want, int ms) {
    long deadline = System.nanoTime() + ms * 1000000L
    while (System.nanoTime() < deadline) {
      if (t.getState() == want) {
        return true
      }
      try {
        Thread.sleep(1)
      } catch (InterruptedException e) {}
    }
    return false
  }

  public static void main(String[] a) {
    Thread fresh = new Thread(new Sleeper())
    System.out.println("new=" + fresh.getState())

    Thread t = new Thread(new Sleeper())
    t.start()
    System.out.println("timed=" + poll(t, Thread.State.TIMED_WAITING, 2000))
    t.join()
    System.out.println("done=" + t.getState())

    final Object lock = new Object()
    final Thread[] holder = new Thread[1]
    synchronized (lock) {
      Thread w = new Thread(() -> {
        synchronized (lock) {}
      })
      holder[0] = w
      w.start()
      System.out.println("blocked=" + poll(w, Thread.State.BLOCKED, 2000))
    }
    holder[0].join()
    System.out.println("afterBlocked=" + holder[0].getState())

    final Object mon = new Object()
    Thread wt = new Thread(() -> {
      synchronized (mon) {
        try {
          mon.wait()
        } catch (InterruptedException e) {}
      }
    })
    wt.start()
    System.out.println("waiting=" + poll(wt, Thread.State.WAITING, 2000))
    synchronized (mon) {
      mon.notifyAll()
    }
    wt.join()
    System.out.println("afterWaiting=" + wt.getState())
    /* Priority: the constants, a stored value with no scheduling promise, and
       a new thread starting at its creator's priority rather than at a value
       set on some other Thread object. */
    Thread p = new Thread(() -> {})
    System.out.println("default=" + p.getPriority() + " consts=" + Thread.MIN_PRIORITY + "," + Thread.NORM_PRIORITY + "," + Thread.MAX_PRIORITY)
    p.setPriority(Thread.MAX_PRIORITY)
    System.out.println("set=" + p.getPriority())
    Thread child = new Thread(() -> {}, "child")
    System.out.println("inherit=" + child.getPriority())
    try {
      p.setPriority(11)
    } catch (IllegalArgumentException e) {
      System.out.println("bad=iae")
    }
    /* holdsLock is the assertion a program writes about its own monitor, and
       onSpinWait is a hint that must simply exist. */
    Object held = new Object()
    System.out.println("before=" + Thread.holdsLock(held))
    synchronized (held) {
      System.out.println("inside=" + Thread.holdsLock(held))
    }
    System.out.println("after=" + Thread.holdsLock(held))
    Thread.onSpinWait()
    System.out.println("spin=ok")
  }
}
