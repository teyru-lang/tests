import java.util.concurrent.*;
import java.util.concurrent.locks.ReentrantLock;
import java.util.concurrent.atomic.*;

public class T321 {
  static void p(String s) { System.out.println(s); }

  public static void main(String[] args) throws Exception {
    Semaphore sem = new Semaphore(2);
    AtomicInteger inside = new AtomicInteger();
    AtomicInteger peak = new AtomicInteger();
    CountDownLatch done = new CountDownLatch(3);
    for (int i = 0; i < 3; i++) {
      Thread t = new Thread(() -> {
        try { sem.acquire(); } catch (InterruptedException e) {}
        int now = inside.incrementAndGet();
        synchronized (sem) { if (now > peak.get()) peak.set(now); }
        inside.addAndGet(-1);
        sem.release();
        done.countDown();
      });
      t.start();
    }
    done.await();
    p("semaphore-peak<=2 " + (peak.get() <= 2));
    p("semaphore-available " + sem.availablePermits());

    Semaphore empty = new Semaphore(0);
    p("try-acquire-empty " + empty.tryAcquire());
    p("try-acquire-timeout " + empty.tryAcquire(10L, TimeUnit.MILLISECONDS));
    empty.release();
    p("try-acquire-after-release " + empty.tryAcquire());
    p("drain " + new Semaphore(3).drainPermits());

    final AtomicInteger trips = new AtomicInteger();
    CyclicBarrier barrier = new CyclicBarrier(3, () -> trips.incrementAndGet());
    final int[] indices = new int[3];
    CountDownLatch met = new CountDownLatch(3);
    for (int i = 0; i < 3; i++) {
      final int slot = i;
      new Thread(() -> {
        try { indices[slot] = barrier.await(); } catch (Exception e) { }
        met.countDown();
      }).start();
    }
    met.await();
    p("barrier-tripped " + trips.get());
    int lo = 99, hi = -1;
    for (int i = 0; i < 3; i++) { if (indices[i] < lo) lo = indices[i]; if (indices[i] > hi) hi = indices[i]; }
    p("barrier-indices " + lo + " " + hi);
    p("barrier-waiting " + barrier.getNumberWaiting());

    CountDownLatch twice = new CountDownLatch(3);
    for (int i = 0; i < 3; i++) {
      new Thread(() -> {
        try { barrier.await(); } catch (Exception e) { }
        twice.countDown();
      }).start();
    }
    twice.await();
    p("barrier-second-trip " + trips.get());

    ReentrantLock lock = new ReentrantLock();
    lock.lock(); lock.lock();
    p("lock-holds " + lock.getHoldCount());
    lock.unlock();
    p("lock-held-after-unlock " + lock.isHeldByCurrentThread());
    lock.unlock();
    p("lock-locked " + lock.isLocked());
    p("lock-hold-count " + lock.getHoldCount());

    final AtomicInteger rejected = new AtomicInteger();
    lock.lock();
    Thread other = new Thread(() -> {
      try { lock.unlock(); } catch (IllegalMonitorStateException e) { rejected.incrementAndGet(); }
    });
    other.start();
    other.join();
    lock.unlock();
    p("lock-foreign-unlock-rejected " + rejected.get());

    final ReentrantLock held = new ReentrantLock();
    final CountDownLatch acquired = new CountDownLatch(1);
    final CountDownLatch release = new CountDownLatch(1);
    Thread holder = new Thread(() -> {
      held.lock();
      acquired.countDown();
      try { release.await(); } catch (InterruptedException e) { p("holder interrupted"); }
      held.unlock();
    });
    holder.start();
    acquired.await();
    p("trylock-while-held " + held.tryLock());
    p("trylock-timeout-while-held " + held.tryLock(10L, TimeUnit.MILLISECONDS));
    release.countDown();
    holder.join();
    p("trylock-after-release " + held.tryLock());
    held.unlock();
  }
}
