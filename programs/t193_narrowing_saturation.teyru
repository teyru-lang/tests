/* Narrowing a floating-point value to an integral type, which is the one
 * conversion where C and Java do not already agree: C leaves a value that does
 * not fit undefined (x86-64's cvttsd2si answers 0x80000000, and an optimiser
 * folding a constant may answer anything -- four builds of `(long) 1.0e20`
 * answered 160, 0, -9223372036854775808 and 48), while JLS 5.1.3 answers NaN,
 * both infinities, and both ends of the range, and truncates toward zero
 * otherwise. Every target, from both floating-point sources, in range and past
 * each bound in both directions, and at the first representable value past each.
 *
 * The expectation is the same program compiled by javac:
 *   javac -d /tmp Narrowing.java && java -cp /tmp Narrowing     (see the .java.ref) */
class Main {
  public static void main(String[] args) {
    System.out.println("double byte (0.0) = " + ((byte) (0.0)))
    System.out.println("double short (0.0) = " + ((short) (0.0)))
    System.out.println("double char (0.0) = " + ((int) ((char) (0.0))))
    System.out.println("double int (0.0) = " + ((int) (0.0)))
    System.out.println("double long (0.0) = " + ((long) (0.0)))
    System.out.println("double byte (0.9) = " + ((byte) (0.9)))
    System.out.println("double short (0.9) = " + ((short) (0.9)))
    System.out.println("double char (0.9) = " + ((int) ((char) (0.9))))
    System.out.println("double int (0.9) = " + ((int) (0.9)))
    System.out.println("double long (0.9) = " + ((long) (0.9)))
    System.out.println("double byte (-0.9) = " + ((byte) (-0.9)))
    System.out.println("double short (-0.9) = " + ((short) (-0.9)))
    System.out.println("double char (-0.9) = " + ((int) ((char) (-0.9))))
    System.out.println("double int (-0.9) = " + ((int) (-0.9)))
    System.out.println("double long (-0.9) = " + ((long) (-0.9)))
    System.out.println("double byte (1.5) = " + ((byte) (1.5)))
    System.out.println("double short (1.5) = " + ((short) (1.5)))
    System.out.println("double char (1.5) = " + ((int) ((char) (1.5))))
    System.out.println("double int (1.5) = " + ((int) (1.5)))
    System.out.println("double long (1.5) = " + ((long) (1.5)))
