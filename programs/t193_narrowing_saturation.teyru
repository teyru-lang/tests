    System.out.println("double short (-1.5) = " + ((short) (-1.5)))
    System.out.println("double char (-1.5) = " + ((int) ((char) (-1.5))))
    System.out.println("double int (-1.5) = " + ((int) (-1.5)))
    System.out.println("double long (-1.5) = " + ((long) (-1.5)))
    System.out.println("double byte (3.99) = " + ((byte) (3.99)))
    System.out.println("double short (3.99) = " + ((short) (3.99)))
    System.out.println("double char (3.99) = " + ((int) ((char) (3.99))))
    System.out.println("double int (3.99) = " + ((int) (3.99)))
    System.out.println("double long (3.99) = " + ((long) (3.99)))
