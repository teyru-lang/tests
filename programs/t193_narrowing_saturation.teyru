    ci += 1.0e20
    System.out.println("compound int += 1e20 = " + ci)
    int cm = 5
    cm *= 1.0e20
    System.out.println("compound int *= 1e20 = " + cm)
    long cl = 5L
    cl -= 1.0e20
    System.out.println("compound long -= 1e20 = " + cl)
    byte cb = 100
    cb += 100.0
    System.out.println("compound byte += 100.0 = " + cb)
    short cs = 100
    cs -= 1.0e20
    System.out.println("compound short -= 1e20 = " + cs)
    char cc = 'a'
    cc += 2.9
    System.out.println("compound char += 2.9 = " + ((int) cc))
