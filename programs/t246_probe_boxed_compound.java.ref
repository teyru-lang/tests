/* The Java twin of t246_probe_boxed_compound.teyru, printed by
   `teyru emit-java` from the same source and compiled with javac 21 to produce
   the .expected file:

     javac -d /tmp t246_probe_boxed_compound.java && java -cp /tmp Main

   A compound assignment whose target is boxed unboxes it, operates on the
   primitive at the primitive's own width, and boxes the result again (JLS
   15.26.2 with 5.1.8 and 5.1.7), with the unboxing's null check before the
   operation. The C back end emits the operator on the reference itself: `(*p)
   /= 2` on a `C_teyru_Long *` is not C at all, and where the operator does
   typecheck on a pointer (`+=`, `-=`) the reference is walked by one element and
   the program segfaults. */
class Main {
  static Long S = 1L;
  static void p(String k, Object v) {
    System.out.println(k + " = " + v);
  }
  public static void main(String[] args) {
    Integer i = 5;
    i += 1;
    p("Integer += 1", i);
    Integer j = 7;
    j -= 1;
    p("Integer -= 1", j);
    Integer k = 5;
    k *= 2;
    p("Integer *= 2", k);
    Integer l = 7;
    l /= 2;
    p("Integer /= 2", l);
    Integer m = 7;
    m %= 2;
    p("Integer %= 2", m);
    Long a = 1L;
    a += 1;
    p("Long += 1", a);
    Long b = 4294967296L;
    b += 1;
    p("Long += 1 past 32 bits", b);
    Long c = 7L;
    c -= 2;
    p("Long -= 2", c);
    Long d = 3L;
    d *= 4;
    p("Long *= 4", d);
    Long e = 7L;
    e /= 2;
    p("Long /= 2", e);
    Long f = 7L;
    f %= 2;
    p("Long %= 2", f);
    Long g = 4294967296L;
    g -= 1;
    p("Long -= 1 past 32 bits", g);
    Double df = 1.5;
    df += 1;
    p("Double += 1", df);
    Double dg = 1.5;
    dg *= 2;
    p("Double *= 2", dg);
    Float fh = 1.5f;
    fh /= 2;
    p("Float /= 2", fh);
    Float fi = 1.5f;
    fi %= 1.0f;
    p("Float %= 1.0f", fi);
    Integer nu = null;
    try {
      nu += 1;
      p("Integer null += 1", nu);
    } catch (NullPointerException ne) {
      p("Integer null += 1", "NullPointerException");
    }
    Long nl = null;
    try {
      nl *= 2;
      p("Long null *= 2", nl);
    } catch (NullPointerException ne) {
      p("Long null *= 2", "NullPointerException");
    }
    Long ctl1 = 1L;
    p("control 1L << 33", ctl1 << 33);
    Long ctl3 = 4294967296L;
    p("control 4294967296L + 1", ctl3 + 1);
    Integer ctl4 = 5;
    p("control 5 + 1", ctl4 + 1);
    S += 1;
    p("static Long += 1", S);
    Long[] arr = new Long[1];
    arr[0] = 1L;
    arr[0] += 1;
    p("Long[] element += 1", arr[0]);
  }
}
