  static long crc32(byte[] b) { CRC32 c = new CRC32(); c.update(b); return c.getValue(); }

  static byte[] unhex(String s) {
    byte[] out = new byte[s.length() / 2];
    for (int i = 0; i < out.length; i++) out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);
    return out;
  }

  static byte[] text(int n) {
    String unit = "The quick brown fox jumps over the lazy dog. ";
    byte[] out = new byte[n];
    for (int i = 0; i < n; i++) out[i] = (byte) unit.charAt(i % unit.length());
    return out;
  }

  static byte[] comp(int n) { byte[] o = new byte[n]; for (int i = 0; i < n; i++) o[i] = (byte)((i%64)*3 + (i/64)); return o; }

  static byte[] inp(int i) {
    if (i == 0) return new byte[0];
    if (i == 1) return "A".getBytes();
    if (i == 2) return "hello world".getBytes();
    if (i == 3) return text(4000);
    return comp(65536);
  }

  static byte[] gzip(byte[] in) throws IOException {
    ByteArrayOutputStream bo = new ByteArrayOutputStream();
    GZIPOutputStream g = new GZIPOutputStream(bo, 512);
    g.write(in);
    g.close();
    return bo.toByteArray();
  }

  static byte[] gunzip(byte[] comp) throws IOException {
    GZIPInputStream in = new GZIPInputStream(new ByteArrayInputStream(comp), 512);
    ByteArrayOutputStream bo = new ByteArrayOutputStream();
    byte[] buf = new byte[4096];
    int n;
    while ((n = in.read(buf)) > 0) bo.write(buf, 0, n);
    return bo.toByteArray();
  }

  static String kind(Throwable e) {
    if (e instanceof ZipException) return "ZipException";
    if (e instanceof EOFException) return "EOFException";
    if (e instanceof IOException) return "IOException";
    return e.getClass().getName();
  }

  static void read(String label, byte[] data) {
    try {
      byte[] got = gunzip(data);
      p(label + " ok len=" + got.length + " crc=" + crc32(got));
    } catch (Throwable e) {
      p(label + " " + kind(e) + ": " + e.getMessage());
    }
  }

  static byte[] headed(byte[] gz, int flg, byte[] field) throws IOException {
    ByteArrayOutputStream bo = new ByteArrayOutputStream();
    byte[] h = new byte[10];
    System.arraycopy(gz, 0, h, 0, 10);
    h[3] = (byte) flg;
    bo.write(h, 0, 10);
    if (field != null) bo.write(field, 0, field.length);
    int at = 10;
    if ((flg & 0x02) != 0) {
      CRC32 c = new CRC32();
      byte[] sofar = bo.toByteArray();
      c.update(sofar);
      long v = c.getValue();
      bo.write((int) (v & 0xFF));
      bo.write((int) ((v >>> 8) & 0xFF));
    }
    bo.write(gz, at, gz.length - at);
    return bo.toByteArray();
  }

  public static void main(String[] args) throws Exception {
    String[] names = { "EMPTY", "ONE", "HELLO", "TEXT", "COMP" };

    for (int i = 0; i < 5; i++) {
      byte[] in = inp(i);
      byte[] z = gzip(in);
      byte[] back = gunzip(z);
      p("round trip " + names[i] + " " + java.util.Arrays.equals(in, back) + " crc=" + crc32(back));
    }

    for (int i = 0; i < 5; i++) {
      byte[] jb = gunzip(unhex(JAVA_GZ[i]));
      p("java gz blob  " + names[i] + " " + java.util.Arrays.equals(inp(i), jb) + " crc=" + crc32(jb));
      byte[] tb = gunzip(unhex(TEYRU_GZ[i]));
      p("teyru gz blob " + names[i] + " " + java.util.Arrays.equals(inp(i), tb) + " crc=" + crc32(tb));
    }

    for (int i = 0; i < 5; i++) {
      byte[] now = gzip(inp(i));
      p("this writer reproduces its blob " + names[i] + " " + java.util.Arrays.equals(unhex(JAVA_GZ[i]), now));
      p("the two writers agree on " + names[i] + " " + java.util.Arrays.equals(unhex(JAVA_GZ[i]), unhex(TEYRU_GZ[i])));
      p("header " + names[i] + " " + unhex(TEYRU_GZ[i])[0] + " " + unhex(TEYRU_GZ[i])[1] + " " + unhex(TEYRU_GZ[i])[2] +
        " " + unhex(TEYRU_GZ[i])[9]);
    }

    byte[] good = gzip(text(4000));
    read("good", good);
    read("empty input", new byte[0]);
    read("two bytes", new byte[]{ 0x1F, (byte) 0x8B });
    byte[] magic = good.clone();
    magic[0] = (byte) 0x1E;
    read("bad magic", magic);
    byte[] method = good.clone();
    method[2] = 9;
    read("bad method", method);
    byte[] crc = good.clone();
    crc[crc.length - 8] = (byte) (crc[crc.length - 8] ^ 1);
    read("bad crc", crc);
    byte[] size = good.clone();
    size[size.length - 1] = (byte) (size[size.length - 1] ^ 1);
    read("bad length", size);
    read("truncated header", java.util.Arrays.copyOf(good, 8));
    read("truncated body", java.util.Arrays.copyOf(good, good.length / 2));
    read("truncated trailer", java.util.Arrays.copyOf(good, good.length - 4));
    read("missing trailer", java.util.Arrays.copyOf(good, good.length - 8));

    read("fextra", headed(good, 0x04, new byte[]{ 2, 0, 7, 8 }));
    read("fname", headed(good, 0x08, "name.txt\u0000".getBytes()));
    read("fcomment", headed(good, 0x10, "a comment\u0000".getBytes()));
    read("fhcrc", headed(good, 0x02, null));

    ByteArrayOutputStream two = new ByteArrayOutputStream();
    two.write(good, 0, good.length);
    two.write(good, 0, good.length);
    read("two members", two.toByteArray());

    ByteArrayOutputStream bo = new ByteArrayOutputStream();
    GZIPOutputStream g = new GZIPOutputStream(bo);
    g.write("abc".getBytes());
    g.finish();
    int len = bo.size();
    g.close();
    p("finish wrote the stream " + (len > 20));
    try {
      g.write("def".getBytes());
      p("write after finish accepted");
    } catch (IOException e) {
      p("write after finish IOException: " + e.getMessage());
    }
    // ---------- a stream that is flushed as it is written ----------
    ByteArrayOutputStream fb = new ByteArrayOutputStream();
    GZIPOutputStream fg = new GZIPOutputStream(fb, 512, true);
    for (int i = 0; i < 20; i++) {
      fg.write(text(500), 0, 500);
      fg.flush();
    }
    fg.close();
    byte[] flushed = gunzip(fb.toByteArray());
    p("synced flush " + flushed.length + " " + crc32(flushed));
    p("done");
  }
}
