/* A local assigned inside a `try` and read in its `catch` or `finally`.
 *
 * This shape was miscompiled for as long as the try lowering has existed: the
 * generated C declared an ordinary automatic, set it between `setjmp` and
 * `longjmp`, and read it afterwards -- which the C standard calls indeterminate,
 * so at -O1 and above the variable read back as its value on entry to the try.
 * At -O0 it was correct, which is why it survived: the suite compiles at -O1 for
 * every other test, but nothing in it read a local out of a catch block.
 *
 * Every kind of local is here, because a fix that covers only some of them is
 * the kind of fix that comes back: a primitive, a reference, a String, a loop
 * counter, an object, a parameter of the enclosing method, and a nested try
 * whose inner catch is inside the outer one. The expectations are what the same
 * program prints when the C compiler is told not to optimize (-O0), and javac's
 * output for the same source, which agree.
 *
 * The .java.ref beside this file is the same program in Java; its output is the
 * .expected. */
class Main {
  // a parameter assigned inside a try and read in the catch: parameters are C
  // parameters in the emitted code, so they are in exactly the same position
  static String fromParam(String p, int n) {
    String out = ""
    try {
      p = p + "!"
      n = n + 10
      out = "assigned"
      throw new IllegalStateException("boom")
    } catch (RuntimeException e) {
      return "p=" + p + " n=" + n + " out=" + out
    }
  }

  // finally sees the values too, and so does code after the whole statement
  static String throughFinally() {
    int a = 1
    String b = "one"
    try {
      a = 2
      b = "two"
      throw new IllegalStateException("x")
    } catch (RuntimeException e) {
      a = a + 100
    } finally {
      a = a + 1000
      b = b + "+finally"
    }
    return "a=" + a + " b=" + b
  }

  static String nested() {
    int outer = 0
    int inner = 0
    try {
      outer = 5
      try {
        inner = 7
        throw new IllegalStateException("inner")
      } catch (RuntimeException e) {
        inner = inner + 1
        throw new IllegalStateException("rethrow")
      }
    } catch (RuntimeException e) {
      return "outer=" + outer + " inner=" + inner
    }
  }

  public static void main(String[] args) {
    int before = 7
    int after = 0
    String s = "start"
    java.util.List<String> list = new java.util.ArrayList<String>()
    try {
      after = 5
      s = "changed"
      list.add("added")
      throw new RuntimeException("x")
    } catch (Throwable e) {
      System.out.println("before=" + before + " after=" + after + " s=" + s + " list=" + list.size())
    }

    int i = 0
    try {
      while (i < 3) {
        i = i + 1
      }
      throw new RuntimeException("y")
    } catch (Throwable e) {
      System.out.println("i=" + i)
    }

    System.out.println(fromParam("hi", 1))
    System.out.println(throughFinally())
    System.out.println(nested())

    // and the value is still there after the whole statement
    System.out.println("after=" + after + " s=" + s + " i=" + i)
  }
}
