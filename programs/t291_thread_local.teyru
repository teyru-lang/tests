/* ThreadLocal: every thread has its own value for one ThreadLocal, remove()
   drops it, and withInitial supplies one on the first get() in each thread.

   The threads are started and joined one at a time so the output has one order;
   what is being tested is which map the value came from, not concurrency. The
   Java twin is t291_thread_local.java.ref, run on OpenJDK 21. */

class Main {
  public static void main(String[] args) {
    ThreadLocal<String> local = new ThreadLocal<String>()
    local.set("main")
    System.out.println("main own=" + local.get())

    Thread a = new Thread(new Runnable() {
      public void run() {
        System.out.println("a initial=" + local.get())
        local.set("A")
        System.out.println("a own=" + local.get())
        local.remove()
        System.out.println("a removed=" + local.get())
      }
    }, "a")
    a.start()
    a.join()

    Thread b = new Thread(new Runnable() {
      public void run() {
        System.out.println("b initial=" + local.get())
        local.set("B")
        System.out.println("b own=" + local.get())
      }
    }, "b")
    b.start()
    b.join()

    System.out.println("main still=" + local.get())

    ThreadLocal<Integer> counter = ThreadLocal.withInitial(new Supplier<Integer>() {
      public Integer get() {
        return 7
      }
    })
    System.out.println("withInitial=" + counter.get())
    counter.set(9)
    System.out.println("after set=" + counter.get())
    counter.remove()
    System.out.println("after remove=" + counter.get())
    System.out.println("done")
  }
}
