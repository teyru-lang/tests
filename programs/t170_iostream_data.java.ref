// The same program written with Java's punctuation, kept so the comparison
// against javac can be redone:
//
//   cp tests/programs/t170_iostream_data.java.ref /tmp/S.java
//   /opt/jdk21/jdk-21.0.11+10/bin/javac -d /tmp/out /tmp/S.java
//   /opt/jdk21/jdk-21.0.11+10/bin/java -cp /tmp/out S
//
// The output is tests/programs/t170_iostream_data.expected, byte for byte.
// (The class is named S; javac wants the file named after it.)
//
// Two spellings differ and only two: chunk text is built with
// Net.stringFrom(bytes, off, len) on the Teyru side and with the String(byte[],
// int, int) constructor here, and the bytes in that chunk are UTF-8 either way.

import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;
import java.io.DataInputStream;
import java.io.DataOutputStream;
import java.io.EOFException;
import java.io.UTFDataFormatException;
import java.nio.charset.StandardCharsets;

class S {
  public static void main(String[] args) throws Exception {
    ByteArrayOutputStream sink = new ByteArrayOutputStream();
    DataOutputStream out = new DataOutputStream(sink);
    out.writeBoolean(true);
    out.writeBoolean(false);
    out.writeByte(-1);
    out.writeByte(200);
    out.writeShort(0x1234);
    out.writeShort(-2);
    out.writeChar(0x4E2D);
    out.writeInt(0x0A0B0C0D);
    out.writeInt(-1);
    out.writeLong(0x0123456789ABCDEFL);
    out.writeLong(-1L);
    out.writeFloat(1.5f);
    out.writeFloat(Float.NaN);
    out.writeDouble(1.5);
    out.writeDouble(-0.0);
    out.writeUTF("");
    out.writeUTF("hi");
    out.writeUTF("héllo");
    out.writeUTF("中文");
    out.writeUTF("😀");

    byte[] bytes = sink.toByteArray();
    System.out.println(bytes.length + " bytes");
    System.out.println(hex(bytes));
    System.out.println("counted " + out.size() + " streamed " + sink.size());

    DataInputStream in = new DataInputStream(new ByteArrayInputStream(bytes));
    System.out.println(in.readBoolean() + " " + in.readBoolean());
    System.out.println((int) in.readByte() + " " + in.readUnsignedByte());
    System.out.println(in.readShort() + " " + in.readUnsignedShort());
    System.out.println((int) in.readChar());
    System.out.println(Long.toHexString(in.readInt()) + " " + in.readInt());
    System.out.println(Long.toHexString(in.readLong()) + " " + in.readLong());
    System.out.println(Float.toString(in.readFloat()) + " " + Float.toString(in.readFloat()));
    System.out.println(Double.toString(in.readDouble()) + " " + Double.toString(in.readDouble()));
    System.out.println("[" + in.readUTF() + "][" + in.readUTF() + "][" + in.readUTF() + "][" +
      in.readUTF() + "][" + in.readUTF() + "]");
    System.out.println("end " + in.read());

    ByteArrayInputStream bais = new ByteArrayInputStream("ABCDEFGH".getBytes(StandardCharsets.UTF_8));
    System.out.println("available " + bais.available() + " " + bais.read() + " " + bais.read());
    bais.mark(0);
    System.out.println("next " + bais.read() + " " + bais.read());
    bais.reset();
    System.out.println("reset " + bais.read() + " available " + bais.available());
    System.out.println("skip " + bais.skip(100) + " available " + bais.available());
    System.out.println("end " + bais.read());

    byte[] window = "hello world".getBytes(StandardCharsets.UTF_8);
    ByteArrayInputStream part = new ByteArrayInputStream(window, 6, 5);
    byte[] chunk = new byte[5];
    int got = part.read(chunk, 0, 5);
    System.out.println("got " + got + " [" + new String(chunk, 0, got, StandardCharsets.UTF_8) +
      "] available " + part.available());
    System.out.println("second " + part.read(chunk, 0, 5));

    ByteArrayOutputStream acc = new ByteArrayOutputStream(1);
    for (int i = 0; i < 40; i++) {
      acc.write(65 + (i % 26));
    }
    System.out.println("size " + acc.size() + " text [" + acc.toString() + "]");
    ByteArrayOutputStream copy = new ByteArrayOutputStream();
    acc.writeTo(copy);
    System.out.println("copy " + copy.size() + " same " + copy.toString().equals(acc.toString()));
    acc.reset();
    System.out.println("reset size " + acc.size() + " text [" + acc.toString() + "]");
    acc.write("hé".getBytes(StandardCharsets.UTF_8), 0, 1);
    acc.write("é".getBytes(StandardCharsets.UTF_8));
    System.out.println("after " + acc.size() + " [" + acc.toString() + "]");
    System.out.println("tail " + hex(acc.toByteArray()));

    ByteArrayOutputStream small = new ByteArrayOutputStream();
    DataOutputStream d2 = new DataOutputStream(small);
    d2.writeByte(1);
    try {
      d2.writeUTF("a".repeat(65536));
      System.out.println("no throw");
    } catch (UTFDataFormatException e) {
      System.out.println("too long: " + e.getMessage());
    }
    d2.writeByte(2);
    System.out.println("after the failure " + hex(small.toByteArray()));

    malformed(new byte[]{0, 2, (byte) 0xC3, 0});
    malformed(new byte[]{0, 1, (byte) 0xFF});
    malformed(new byte[]{0, 1, (byte) 0xC3});
    malformed(new byte[]{0, 3, (byte) 0xE2, (byte) 0x82, 0x41});

    ByteArrayOutputStream nulOut = new ByteArrayOutputStream();
    DataOutputStream nulWriter = new DataOutputStream(nulOut);
    String nul = new String(new byte[1], StandardCharsets.UTF_8);
    nulWriter.writeUTF(nul);
    System.out.println("nul " + hex(nulOut.toByteArray()));
    String nulBack = new DataInputStream(new ByteArrayInputStream(nulOut.toByteArray())).readUTF();
    System.out.println("nul back " + nulBack.length() + " " + nulBack.equals(nul));

    byte[] pair = new byte[]{0, 6, (byte) 0xED, (byte) 0xA0, (byte) 0xBD, (byte) 0xED,
      (byte) 0xB8, (byte) 0x80};
    System.out.println("pair " + new DataInputStream(new ByteArrayInputStream(pair)).readUTF());

    try {
      new DataInputStream(new ByteArrayInputStream(new byte[]{1, 2})).readFully(new byte[4]);
      System.out.println("no throw");
    } catch (EOFException e) {
      System.out.println("EOFException");
    }

    ByteArrayOutputStream big = new ByteArrayOutputStream();
    new DataOutputStream(big).writeUTF("b".repeat(65535));
    DataInputStream binned = new DataInputStream(new ByteArrayInputStream(big.toByteArray()));
    System.out.println("big " + binned.readUTF().length() + " " + big.size());
  }

  static void malformed(byte[] payload) throws Exception {
    try {
      new DataInputStream(new ByteArrayInputStream(payload)).readUTF();
      System.out.println("no throw");
    } catch (UTFDataFormatException e) {
      System.out.println("bad: " + e.getMessage());
    }
  }

  static String hex(byte[] b) {
    StringBuilder sb = new StringBuilder();
    for (int i = 0; i < b.length; i++) {
      int v = b[i] & 255;
      if (v < 16) {
        sb.append('0');
      }
      sb.append(Integer.toHexString(v));
    }
    return sb.toString();
  }
}
