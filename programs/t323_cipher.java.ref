import javax.crypto.AEADBadTagException;
import javax.crypto.BadPaddingException;
import javax.crypto.Cipher;
import javax.crypto.IllegalBlockSizeException;
import javax.crypto.spec.GCMParameterSpec;
import javax.crypto.spec.IvParameterSpec;
import javax.crypto.spec.SecretKeySpec;
import java.security.KeyFactory;
import java.security.Signature;
import java.security.interfaces.RSAPrivateKey;
import java.security.interfaces.RSAPublicKey;
import java.security.spec.PKCS8EncodedKeySpec;
import java.security.spec.X509EncodedKeySpec;
import java.util.HexFormat;

public class T323 {
  static HexFormat HF = HexFormat.of();
  static void p(String s) { System.out.println(s); }

  static String hex(byte[] b) {
    StringBuilder sb = new StringBuilder();
    for (int i = 0; i < b.length; i++) {
      int v = b[i] & 0xFF;
      sb.append("0123456789abcdef".charAt(v >> 4));
      sb.append("0123456789abcdef".charAt(v & 15));
    }
    return sb.toString();
  }

  static byte[] bytes(int[] v) {
    byte[] b = new byte[v.length];
    for (int i = 0; i < v.length; i++) b[i] = (byte) v[i];
    return b;
  }

  static int[] range(int from, int n) {
    int[] v = new int[n];
    for (int i = 0; i < n; i++) v[i] = (from + i) & 0xFF;
    return v;
  }

  static final String RSA_PUBLIC = "";
  static final String RSA_PRIVATE = "";
  static final String RSA_SIGNATURE = "b7b1edf2ec8db20e67ac4e3460c705d558381e64a71beaf1fbc493ba4fc6064290f705da3070161963c50b94acd23043627f1a907ee052e941865a4e4111a4730f4ba77624f5831c33d72c39ec04a1b26baead466ad7b9fe28c25f9325ea967383a945e4d7ca4f243f639fc55148186b32c4cee2cd930a2239cf256c7908f299";

  public static void main(String[] args) throws Exception {
    /* ---- FIPS-197 */
    byte[] k128 = bytes(new int[]{0x00,0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,0x09,0x0a,0x0b,0x0c,0x0d,0x0e,0x0f});
    byte[] k192 = bytes(range(0x08, 24));
    byte[] k256 = bytes(range(0x00, 32));
    byte[] pt = bytes(new int[]{0x00,0x11,0x22,0x33,0x44,0x55,0x66,0x77,0x88,0x99,0xaa,0xbb,0xcc,0xdd,0xee,0xff});
    for (int i = 0; i < 3; i++) {
      byte[] key = i == 0 ? k128 : i == 1 ? k192 : k256;
      Cipher c = Cipher.getInstance("AES/ECB/NoPadding");
      c.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(key, "AES"));
      byte[] ct = c.doFinal(pt);
      c.init(Cipher.DECRYPT_MODE, new SecretKeySpec(key, "AES"));
      p("ecb" + (i * 64 + 128) + "=" + hex(ct) + " " + hex(c.doFinal(ct)));
    }

    /* ---- SP 800-38A */
    byte[] fkey = bytes(new int[]{0x2b,0x7e,0x15,0x16,0x28,0xae,0xd2,0xa6,0xab,0xf7,0x15,0x88,0x09,0xcf,0x4f,0x3c});
    byte[] iv = bytes(range(0, 16));
    byte[] four = bytes(new int[]{0x6b,0xc1,0xbe,0xe2,0x2e,0x40,0x9f,0x96,0xe9,0x3d,0x7e,0x11,0x73,0x93,0x17,0x2a,
                              0xae,0x2d,0x8a,0x57,0x1e,0x03,0xac,0x9c,0x9e,0xb7,0x6f,0xac,0x45,0xaf,0x8e,0x51,
                              0x30,0xc8,0x1c,0x46,0xa3,0x5c,0xe4,0x11,0xe5,0xfb,0xc1,0x19,0x1a,0x0a,0x52,0xef,
                              0xf6,0x9f,0x24,0x45,0xdf,0x4f,0x9b,0x17,0xad,0x2b,0x41,0x7b,0xe6,0x6c,0x37,0x10});
    Cipher cbc = Cipher.getInstance("AES/CBC/NoPadding");
    cbc.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(fkey, "AES"), new IvParameterSpec(iv));
    byte[] cbcCt = cbc.doFinal(four);
    p("cbc=" + hex(cbcCt));
    cbc.init(Cipher.DECRYPT_MODE, new SecretKeySpec(fkey, "AES"), new IvParameterSpec(iv));
    p("cbc-pt=" + hex(cbc.doFinal(cbcCt)));
    Cipher ctr = Cipher.getInstance("AES/CTR/NoPadding");
    byte[] ctrIv = bytes(new int[]{0xf0,0xf1,0xf2,0xf3,0xf4,0xf5,0xf6,0xf7,0xf8,0xf9,0xfa,0xfb,0xfc,0xfd,0xfe,0xff});
    ctr.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(fkey, "AES"), new IvParameterSpec(ctrIv));
    p("ctr=" + hex(ctr.doFinal(four)));

    /* ---- SP 800-38D */
    byte[] gkey = bytes(range(0, 16));
    byte[] giv = bytes(range(0, 12));
    byte[] gpt = bytes(range(0, 16));
    Cipher gcm = Cipher.getInstance("AES/GCM/NoPadding");
    gcm.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(gkey, "AES"), new GCMParameterSpec(128, giv));
    byte[] sealed = gcm.doFinal(gpt);
    p("gcm=" + hex(sealed));
    gcm.init(Cipher.DECRYPT_MODE, new SecretKeySpec(gkey, "AES"), new GCMParameterSpec(128, giv));
    p("gcm-pt=" + hex(gcm.doFinal(sealed)));
    byte[] tampered = new byte[sealed.length];
    System.arraycopy(sealed, 0, tampered, 0, sealed.length);
    tampered[sealed.length - 1] = (byte) (tampered[sealed.length - 1] ^ 1);
    gcm.init(Cipher.DECRYPT_MODE, new SecretKeySpec(gkey, "AES"), new GCMParameterSpec(128, giv));
    try {
      gcm.doFinal(tampered);
      p("tampered=accepted");
    } catch (AEADBadTagException e) {
      p("tampered=refused");
    }

    /* ---- padding */
    Cipher pad = Cipher.getInstance("AES/CBC/PKCS5Padding");
    pad.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(fkey, "AES"), new IvParameterSpec(iv));
    for (int len : new int[]{0, 1, 15, 16, 17}) {
      byte[] msg = new byte[len];
      for (int i = 0; i < len; i++) msg[i] = (byte) ('a' + i);
      byte[] ct = pad.doFinal(msg);
      pad.init(Cipher.DECRYPT_MODE, new SecretKeySpec(fkey, "AES"), new IvParameterSpec(iv));
      p("padding" + len + "=" + ct.length + " " + new String(pad.doFinal(ct)));
      pad.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(fkey, "AES"), new IvParameterSpec(iv));
    }
    try {
      pad.doFinal(new byte[]{1, 2, 3});
    } catch (IllegalBlockSizeException e) {
      p("bad-block-size=refused");
    }

    /* ---- RSA */
    HexFormat hf = HF;
    KeyFactory kf = KeyFactory.getInstance("RSA");
    RSAPublicKey pub = (RSAPublicKey) kf.generatePublic(new X509EncodedKeySpec(hf.parseHex(RSA_PUBLIC)));
    RSAPrivateKey priv = (RSAPrivateKey) kf.generatePrivate(new PKCS8EncodedKeySpec(hf.parseHex(RSA_PRIVATE)));
    p("modulus-bits=" + pub.getModulus().bitLength());
    p("exponent=" + pub.getPublicExponent().toString());
    p("private-modulus-match=" + priv.getModulus().equals(pub.getModulus()));
    Cipher rsa = Cipher.getInstance("RSA/ECB/PKCS1Padding");
    rsa.init(Cipher.ENCRYPT_MODE, pub);
    byte[] ct = rsa.doFinal("hello rsa".getBytes());
    p("rsa-ctlen=" + ct.length);
    Cipher rsad = Cipher.getInstance("RSA");
    rsad.init(Cipher.DECRYPT_MODE, priv);
    p("rsa-pt=" + new String(rsad.doFinal(ct)));
    /* A ciphertext shorter than the modulus is a padding failure in Java, and
       one longer than it is a length failure. Both are reported as "refused",
       because the class name carries this library's package rather than;
       java.security's and the message is the only stable part. */;
    try {
      rsad.doFinal("not a ciphertext".getBytes());
      p("rsa-short=accepted");
    } catch (BadPaddingException e) {
      p("rsa-short=refused");
    }
    try {
      rsad.doFinal(new byte[129]);
      p("rsa-long=accepted");
    } catch (IllegalBlockSizeException e) {
      p("rsa-long=refused");
    }

    /* The signature was made by openssl over "the message to sign", so the
       verifier is checked against a signer this library did not write. */;
    Signature verify = Signature.getInstance("SHA256withRSA");
    verify.initVerify(pub);
    verify.update("the message to sign".getBytes());
    p("signature=" + verify.verify(hf.parseHex(RSA_SIGNATURE)));
    Signature wrong = Signature.getInstance("SHA256withRSA");
    wrong.initVerify(pub);
    wrong.update("a different message".getBytes());
    p("signature-wrong-message=" + wrong.verify(hf.parseHex(RSA_SIGNATURE)));
  }
}

