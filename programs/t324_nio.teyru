/* java.nio: a heap ByteBuffer, a datagram channel, a non-blocking stream
   channel and a Selector over both.

   The values are all deterministic -- ports come from bind(0) and are printed
   nowhere, and every address is 127.0.0.1 -- so this is a golden file rather
   than a property test. What it pins, in order:

     * ByteBuffer's position/limit arithmetic, including flip/clear/rewind and
       the six primitive get/put pairs;
     * a datagram's message boundary, its sender address, and a zero-length
       datagram (which is a message, not an end of stream);
     * a Selector that reports an accept-ready server channel, a readable
       client, and a write-ready channel after the send buffer is drained;
     * a non-blocking read that answers 0 when there is nothing, which is the
       answer a loop depends on and the one an exception would break.

   There is no .java.ref: java.nio's Selector is an operating-system object
   there and a poll set here, and the API differences (bind returns the
   channel, receive answers the sender through an out parameter) make the two
   programs different beyond translation. The expectation is this program's own
   output, reviewed against Java's semantics rather than generated by the JDK;
   the tests that are differentials (t318, t319, t323) are the ones where the
   JDK can be the oracle. */
class T324 {
  static void p(String s) {
    System.out.println(s)
  }

  static String hex(byte[] b) {
    StringBuilder sb = new StringBuilder()
    for (int i = 0 : i < b.length : i++) {
      int v = b[i] & 0xFF
      sb.append("0123456789abcdef".charAt(v >> 4))
      sb.append("0123456789abcdef".charAt(v & 15))
    }
    return sb.toString()
  }

  public static void main(String[] args) {
    /* ---- ByteBuffer */
    ByteBuffer b = ByteBuffer.allocate(64)
    b.putInt(0x01020304).putLong(0x0102030405060708L).putShort((short) 0x0a0b).put((byte) 0x7f)
    p("pos=" + b.position() + " lim=" + b.limit())
    b.flip()
    p("int=" + hex(intBytes(b.getInt())))
    p("long=" + hex(longBytes(b.getLong())))
    p("short=" + hex(shortBytes(b.getShort())))
    p("byte=" + Integer.toHexString(b.get() & 255))
    p("remaining=" + b.remaining())
    b.clear()
    p("clear=" + b.position() + " " + b.limit())
    b.position(5)
    b.rewind()
    p("rewind=" + b.position())
    byte[] payload = "nio".getBytes()
    ByteBuffer src = ByteBuffer.wrap(payload)
    byte[] dst = new byte[3]
    src.get(dst)
    p("wrap=" + new String(dst) + " pos=" + src.position())
    ByteBuffer dbl = ByteBuffer.allocate(8)
    dbl.putDouble(1.5)
    dbl.flip()
    p("double=" + dbl.getDouble())
    ByteBuffer flt = ByteBuffer.allocate(4)
    flt.putFloat(2.5f)
    flt.flip()
    p("float=" + flt.getFloat())

    /* ---- datagram */
    DatagramChannel server = DatagramChannel.open().bind(0)
    DatagramChannel client = DatagramChannel.open()
    InetSocketAddress to = new InetSocketAddress("127.0.0.1", server.getLocalPort())
    p("udp-sent=" + client.send(ByteBuffer.wrap("datagram".getBytes()), to))
    ByteBuffer in = ByteBuffer.allocate(64)
    InetSocketAddress[] from = new InetSocketAddress[1]
    int n = server.receive(in, from)
    in.flip()
    byte[] got = new byte[in.remaining()]
    in.get(got)
    p("udp=" + new String(got) + " n=" + n + " from=" + from[0].getHostString())

    /* A zero-length datagram is a message, and the receive answers 0 with the
       sender set -- not the -1 an end of stream would give. */
    client.send(ByteBuffer.allocate(0), to)
    ByteBuffer empty = ByteBuffer.allocate(16)
    InetSocketAddress[] from2 = new InetSocketAddress[1]
    p("udp-empty=" + server.receive(empty, from2) + " from=" + from2[0].getHostString())

    /* ---- selector over a stream socket */
    ServerSocketChannel ssc = ServerSocketChannel.open().bind(0)
    Selector sel = Selector.open()
    SelectionKey acceptKey = ssc.register(sel, SelectionKey.OP_ACCEPT)
    SocketChannel clientCh = SocketChannel.open()
    clientCh.connect(new InetSocketAddress("127.0.0.1", ssc.getLocalPort()))
    p("select-accept=" + sel.select(2000L))
    p("acceptable=" + acceptKey.isAcceptable())
    SocketChannel accepted = ssc.accept()
    p("accepted=" + (accepted != null))

    /* The server end is what becomes readable: the client writes, the accepted
       channel receives. Registering the writer for OP_READ is the mistake this
       ordering exists to avoid. */
    accepted.configureBlocking(false)
    clientCh.configureBlocking(true)
    SelectionKey readKey = accepted.register(sel, SelectionKey.OP_READ)
    p("select-read-none=" + sel.selectNow())
    clientCh.write(ByteBuffer.wrap("through-the-channel".getBytes()))
    p("select-read=" + sel.select(2000L))
    p("readable=" + readKey.isReadable())
    ByteBuffer readBuf = ByteBuffer.allocate(64)
    int r = accepted.read(readBuf)
    readBuf.flip()
    byte[] readBytes = new byte[readBuf.remaining()]
    readBuf.get(readBytes)
    p("channel=" + new String(readBytes) + " r=" + r)
    /* A second non-blocking read with nothing left answers 0, not -1 and not an
       exception: 0 is "nothing now", which is what a selector loop expects. */
    p("idle-read=" + accepted.read(ByteBuffer.allocate(16)))

    clientCh.close()
    accepted.close()
    ssc.close()
    client.close()
    server.close()
    sel.close()
  }

  static byte[] intBytes(int v) {
    ByteBuffer b = ByteBuffer.allocate(4)
    b.putInt(v)
    return b.array()
  }

  static byte[] longBytes(long v) {
    ByteBuffer b = ByteBuffer.allocate(8)
    b.putLong(v)
    return b.array()
  }

  static byte[] shortBytes(short v) {
    ByteBuffer b = ByteBuffer.allocate(2)
    b.putShort(v)
    return b.array()
  }
}
