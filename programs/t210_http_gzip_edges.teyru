import teyru.*

/* gzip, both directions, and the two ways a body can lie about being gzip.

   What is pinned here is not the format -- t177 and t178 settle that, and t180
   checks the wiring of Content-Encoding through handle() -- but what happens at
   the edges a live client reaches:

   * a request that offers gzip gets a body that is compressed *on the wire*:
     the bytes are read raw, so the test decodes them itself rather than
     trusting the client's decoder, and the Vary header says the answer depends
     on what the request offered. A request that offers nothing gets the bytes
     the handler wrote.
   * a request whose body claims to be gzip and is not. A server that does not
     decode request bodies must still answer: the handler gets the bytes that
     arrived, and nothing about a coding the server never agreed to can crash it
     or leave it waiting.
   * a response whose body claims to be gzip and is not, and a response whose
     body is a gzip stream that ends in the middle. Both are the client's
     problem, and both must be an exception the caller can read rather than a
     hang -- and neither may make the client send the request a second time,
     which is what the counters here are for: a POST retried because the answer
     could not be decoded is a second side effect, which is worse than the
     error it is covering for.

   The port is asked for and never printed. */

@RestController
@RequestMapping("/api")
class GzipApi {
  // Counted, not printed: the route runs on the serving thread, and the count
  // is read after the client call has returned.
  public static AtomicInteger claimed = new AtomicInteger()
  public static AtomicInteger truncated = new AtomicInteger()

  @GetMapping("/big")
  HttpResponse big() {
    HttpResponse res = new HttpResponse()
    res.body = Bodies.big()
    res.gzipBody = true
    return res
  }

  // A body that says it is gzip and is not.
  @GetMapping("/claimed")
  HttpResponse claimed() {
    claimed.incrementAndGet()
    HttpResponse res = new HttpResponse()
    res.header("Content-Encoding", "gzip")
    res.body = "this is not a gzip stream at all"
    return res
  }

  // A gzip stream cut in half: the header of a member and part of its data, and
  // then the end of the body.
  @GetMapping("/truncated")
  HttpResponse truncated() {
    truncated.incrementAndGet()
    // Gzip is bytes at both ends now (the string work took the last binary
    // format out of String), so the truncation below is a byte range rather than
    // a substring: the case is a gzip member cut in half, and half of it is half
    // its bytes.
    byte[] packed = Gzip.compress(Bodies.big())
    HttpResponse res = new HttpResponse()
    res.header("Content-Encoding", "gzip")
    res.bodyBytes = Arrays.copyOfRange(packed, 0, packed.length / 2)
    return res
  }

  @PostMapping("/echo")
  String echo(@RequestBody String text) {
    return "len=" + text.length()
  }
}

class Bodies {
  public static String big() {
    StringBuilder b = new StringBuilder()
    for (int i = 0 : i < 64 : i++) {
      b.append("the quick brown fox jumps over the lazy dog, line ").append(i).append("\n")
    }
    return b.toString()
  }
}

class T210 {
  public static void main(String[] args) throws Exception {
    ApplicationContext ctx = new ApplicationContext()
    ctx.refresh()
    HttpServer server = new HttpServer(0, Application.routerFrom(ctx), ctx)
    server.bind()
    int port = server.getPort()
    ServerTask task = new ServerTask(server)
    Thread serving = new Thread(task, "server")
    serving.start()

    // ---------- a response that is compressed on the wire ----------
    RawResponse packed = raw(port, "GET /api/big HTTP/1.1\r\nHost: x\r\nAccept-Encoding: gzip\r\nConnection: close\r\n\r\n")
    System.out.println("gzip-offered -> " + packed.statusLine +
        " encoding=[" + packed.header("Content-Encoding") + "]" +
        " vary=[" + packed.header("Vary") + "]" +
        " length=" + packed.header("Content-Length") +
        " decodes=" + Gzip.decompressText(packed.bodyBytes).equals(Bodies.big()) +
        " shorter=" + (packed.bodyBytes.length < Bodies.big().length()))
    RawResponse plain = raw(port, "GET /api/big HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
    System.out.println("gzip-not-offered -> " + plain.statusLine +
        " encoding=[" + plain.header("Content-Encoding") + "]" +
        " length=" + plain.header("Content-Length") +
        " is-text=" + plain.body.equals(Bodies.big()))

    // ---------- a request body that claims to be gzip ----------
    // seven bytes that are not a gzip stream, claimed as one
    RawResponse junk = raw(port, "POST /api/echo HTTP/1.1\r\nHost: x\r\nContent-Encoding: gzip\r\nContent-Length: 7\r\nConnection: close\r\n\r\nnot-gzi")
    System.out.println("request-body-claimed-gzip -> " + junk.statusLine + " body=[" + junk.body + "]")
    // and one that really is: a server that does not decode request bodies
    // hands the handler the bytes that arrived, which is the answer it can give.
    // Those bytes are not text, so the String the handler is bound to is the
    // UTF-8 decode with replacements, and len= is that decode's length: the JDK
    // gives the same number for these bytes (224, 71 of them U+FFFD). Before W5
    // the length was the byte count, because a String was one byte per character.
    byte[] real = Gzip.compress(Bodies.big())
    // The head is text and the body is bytes, sent as such: a compressed body
    // through a String is the thing this file is about not doing.
    RawClient body = new RawClient(port)
    body.send("POST /api/echo HTTP/1.1\r\nHost: x\r\nContent-Encoding: gzip\r\nContent-Length: " + real.length + "\r\nConnection: close\r\n\r\n")
    body.sendBytes(real)
    RawResponse gz = body.read()
    body.close()
    System.out.println("request-body-real-gzip -> " + gz.statusLine + " body=[" + gz.body + "]")

    // ---------- a response body that lies, through the client ----------
    // The client decompresses what the answer said was compressed, so this is
    // the client's half: an exception it can read, once, and no second request.
    System.out.println("client-claimed-not-gzip -> " + client(port, "/api/claimed"))
    System.out.println("claimed-requests=" + GzipApi.claimed.get())
    System.out.println("client-truncated-member -> " + client(port, "/api/truncated"))
    System.out.println("truncated-requests=" + GzipApi.truncated.get())

    task.stop()
    serving.join()
    server.close()
    System.out.println("done")
  }

  // client asks over the client library, which expands a compressed body, and
  // answers with the exception or the body it got.
  static String client(int port, String path) {
    HttpClient c = HttpClient.newHttpClient().connectTimeout(5000)
    try {
      HttpClientResponse res = c.send(
          HttpClientRequest.of("GET", "http://127.0.0.1:" + port + path).acceptGzip())
      return "status=" + res.statusCode() + " body=[" + res.body() + "]"
    } catch (IOException e) {
      return e.getClass().getName() + ": " + e.getMessage()
    } finally {
      c.close()
    }
  }

  static RawResponse raw(int port, String request) {
    RawClient c = new RawClient(port)
    try {
      c.send(request)
      return c.read()
    } finally {
      c.close()
    }
  }
}
