/* Before a shift, every integral operand but long is promoted to int (JLS
 * 15.19 with 5.6): the promotion widens a byte or a short by sign extension and
 * a char by zero extension, so `b >>> 1` on a byte of -1 is 2147483647 rather
 * than 127, and a char of 0x8000 shifted right is 16384 rather than negative.
 * The count keeps only its low five bits (six for a long) -- and the count is
 * masked in the type the shift is performed in, which is int for a byte, short
 * or char operand even when the count is a long.
 *
 * The same promotion is what makes the compound forms interesting: `E1 op= E2`
 * is `E1 = (T) ((E1) op (E2))` (JLS 15.26.2), so a byte target shifts in int and
 * is narrowed back afterwards, which is why `byte b = -1; b >>>= 1` stays -1
 * instead of becoming 127, and why `byte b = -1; b <<= 1` is -2.
 *
 * The expectation is the same program compiled by javac 21:
 *   javac -d /tmp t243_probe_shift_promotion.java && java -cp /tmp Main
 *   (see the .java.ref) */
import teyru.*

class Main {
  static void p(String k, Object v) {
    System.out.println(k + " = " + v)
  }

  public static void main(String[] args) {
    // widening a byte, a short and a char before a shift
    byte b = -1
    p("byte >>> 1", b >>> 1)
    p("byte >> 1", b >> 1)
    p("byte << 1", b << 1)
    short s = -1
    p("short >>> 4", s >>> 4)
    p("short >> 4", s >> 4)
    p("short << 4", s << 4)
    char c = (char) 65535
    p("char >>> 4", c >>> 4)
    p("char >> 4", c >> 4)
    p("char << 4", c << 4)
    char c2 = (char) 32768
    p("char 0x8000 >> 1", c2 >> 1)
    p("char 0x8000 >>> 1", c2 >>> 1)
    p("char 0x8000 << 1", c2 << 1)

    // a count that is negative, or past the width, at run time
    int n = -1
    p("1 << -1", 1 << n)
    p("1L << -1", 1L << n)
    p("1L << -65", 1L << -65)
    p("-1 >>> -1", -1 >>> n)
    p("1 << 32", 1 << 32)
    p("1 << 33", 1 << 33)
    p("1L << 64", 1L << 64)
    p("1L << 65", 1L << 65)
    p("1L << 32", 1L << 32)

    // the result narrowed by hand afterwards
    p("(byte)(1 << 7)", (byte) (1 << 7))
    p("(short)(1 << 15)", (short) (1 << 15))
    p("(byte)(-1 >>> 24)", (byte) (-1 >>> 24))
    p("(int)(1L << 32)", (int) (1L << 32))
    p("(short)(-1 >>> 16)", (short) (-1 >>> 16))

    // the extreme operands
    p("MIN >>> 1", Integer.MIN_VALUE >>> 1)
    p("MIN >> 1", Integer.MIN_VALUE >> 1)
    p("MIN << 1", Integer.MIN_VALUE << 1)
    p("LMIN >>> 1", Long.MIN_VALUE >>> 1)
    p("LMIN >> 63", Long.MIN_VALUE >> 63)
    p("MAX << 1", Integer.MAX_VALUE << 1)

    // the compound forms on the narrow types
    byte sb = -1
    sb >>>= 1
    p("byte >>>= 1", sb)
    sb >>= 1
    p("byte >>= 1", sb)
    sb <<= 1
    p("byte <<= 1", sb)
    short ss = -1
    ss >>>= 8
    p("short >>>= 8", ss)
    ss >>= 8
    p("short >>= 8", ss)
    char sc = (char) 32768
    sc >>>= 4
    p("char 0x8000 >>>= 4", (int) sc)
    char sc2 = (char) 65535
    sc2 >>= 4
    p("char 0xFFFF >>= 4", (int) sc2)
    long sl = 1L
    sl <<= 64
    p("long <<= 64", sl)
    sl = 1L
    sl <<= 70
    p("long <<= 70", sl)
    sl >>>= 70
    p("long >>>= 70", sl)
    int si = -1
    si >>>= 0
    p("int >>>= 0", si)

    // a count that arrives boxed, and a count that arrives as a field
    Integer boxed = 33
    int q = 1
    p("1 << boxed", q << boxed)
    q <<= boxed
    p("q <<= boxed", q)
    p("1L << boxed", 1L << boxed)
  }
}
