import teyru.*

/* A WebSocket handler that throws an Error, and the server that has to survive it.

   A route is called reflectively, and the invoker wraps what it calls: a
   handler's failure arrives at the dispatcher as an InvocationTargetException,
   which is an Exception, which is why an HTTP handler that runs out of stack is
   already answered 500 by a catch (Exception).

   A WebSocket handler is the one place a program's code is called directly.
   WebSocketConnection calls onMessage and onOpen itself, so a failure from one
   arrives as it was thrown -- an Error included -- and an Error is not an
   Exception. Before this, it left the connection loop and ended the thread that
   answers every client: the session's client saw a close it did not ask for and
   the next HTTP request saw nothing at all.

   What is asserted is that second half, because it is the visible one: the
   handshake is answered, the session dies with its handler, and the next
   request is answered anyway. */

class BoomSocket implements WebSocketHandler {
  public void onOpen(WebSocketSession s) {
    throw new StackOverflowError("thrown by a WebSocket handler")
  }

  public void onMessage(WebSocketSession s, String text) {
  }

  public void onBinary(WebSocketSession s, byte[] data) {
  }

  public void onClose(WebSocketSession s) {
  }
}

@RestController
class SocketErrorApi {
  @GetMapping("/ok")
  String ok() {
    return "fine"
  }
}

class T227 {
  public static void main(String[] args) throws Exception {
    ApplicationContext ctx = new ApplicationContext()
    ctx.refresh()
    HttpServer server = new HttpServer(0, Application.routerFrom(ctx), ctx)
    server.addWebSocket("/ws", new BoomSocket())
    server.bind()
    int port = server.getPort()
    ServerTask task = new ServerTask(server)
    Thread serving = new Thread(task, "server")
    serving.start()

    System.out.println("a session whose handler throws an Error -> " + upgrade(port))
    System.out.println("the next request -> " + ask(port, "/ok"))

    task.stop()
    serving.join()
    server.close()
    System.out.println("done")
  }

  // upgrade completes a handshake and answers the status line. The session's
  // failure happens after the 101 -- onOpen is the first thing the session does
  // -- so the 101 is what says the handshake was answered at all.
  static String upgrade(int port) {
    Socket s = new Socket("127.0.0.1", port)
    s.setSoTimeout(1000)
    try {
      s.getOutputStream().write("GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n" +
          "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n")
      s.getOutputStream().flush()
      SocketInputStream in = s.getInputStream()
      String line = in.readLine()
      return line == null ? "<no answer>" : line
    } catch (IOException e) {
      return e.getClass().getName()
    } finally {
      s.close()
    }
  }

  // ask retries a read that timed out with nothing in hand: a collection cannot
  // stop a thread that is inside recv(), and this program's client is one, so a
  // pause during a handler waits for the client's own read to end. Nothing has
  // been read when that happens, so the retry starts at the answer.
  static String ask(int port, String path) {
    Socket s = new Socket("127.0.0.1", port)
    s.setSoTimeout(500)
    try {
      s.getOutputStream().write("GET " + path + " HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
      s.getOutputStream().flush()
      SocketInputStream in = s.getInputStream()
      for (int attempt = 0 : attempt < 40 : attempt++) {
        try {
          String line = in.readLine()
          return line == null ? "<no answer>" : line
        } catch (SocketTimeoutException e) {
        }
      }
      return "<no answer>"
    } catch (IOException e) {
      return e.getClass().getName()
    } finally {
      s.close()
    }
  }
}
