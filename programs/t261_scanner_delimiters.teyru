import teyru.*

/* Scanner's delimiter set: \p{javaWhitespace}, which is what Java's scanner
 * splits tokens on, and not a set of this class's own.
 *
 * It was the ten ASCII characters of it, so every Unicode space was an ordinary
 * character here: U+3000 IDEOGRAPHIC SPACE and U+2000..U+200A did not separate
 * two tokens, and the three non-breaking spaces -- which Java does not treat as
 * whitespace -- were indistinguishable from the ones it does. Each line below
 * is one code point followed by "5", so the token says which way the character
 * went: a token of "5" means the character separated, a token of both means it
 * did not.
 *
 * U+0085 NEXT LINE is the interesting one: it is a line terminator to Java's
 * Scanner and not whitespace, so it is not a delimiter. U+2028 and U+2029 are
 * both, and both are in t262 as well.
 *
 * The expectations are the output of t261_scanner_delimiters.java.ref on
 * OpenJDK 21.0.11+10.
 */

class Main {
  static String hex4(int cp) {
    String d = "0123456789ABCDEF"
    StringBuilder s = new StringBuilder()
    for (int shift = 12 : shift >= 0 : shift = shift - 4) {
      s.append(d.charAt((cp >> shift) & 0xF))
    }
    return s.toString()
  }

  static String codes(String s) {
    if (s.length() == 0) {
      return "[]"
    }
    StringBuilder b = new StringBuilder("[")
    for (int i = 0 : i < s.length() : i++) {
      if (i > 0) {
        b.append(" ")
      }
      b.append((int) s.charAt(i))
    }
    return b.append("]").toString()
  }

  static void delimit(int cp) {
    String source = "" + (char) cp + "5"
    /* the token of a one-character source and then a control character: a
       delimiter is skipped and the token is "5", anything else is part of it */
    System.out.println("U+" + hex4(cp) + " token " + codes(new Scanner(source).next()) +
        " control " + codes(new Scanner("x" + (char) cp + "y").next()))
  }

  public static void main(String[] args) {
    // whitespace to Java, and not ASCII
    delimit(0x3000)
    delimit(0x2000)
    delimit(0x200A)
    delimit(0x205F)
    delimit(0x1680)
    // not whitespace to Java, whatever they look like
    delimit(0x00A0)
    delimit(0x2007)
    delimit(0x202F)
    // a line terminator to Java and not a delimiter
    delimit(0x0085)
    // both whitespace and a line terminator
    delimit(0x2028)
    delimit(0x2029)
    // the ASCII ten, as the control
    delimit(0x20)
    delimit(0x09)
    delimit(0x1C)
    delimit(0x1F)
    // and one that is neither
    delimit(0x41)
  }
}
