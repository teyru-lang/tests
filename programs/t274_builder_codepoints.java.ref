// The Java this case was taken from, run by the JDK that produced the
// .expected file beside it:
//
//   cp tests/programs/t274_builder_codepoints.java.ref /tmp/Codepoints.java
//   javac -d /tmp/out /tmp/Codepoints.java
//   java -ea -Dstdout.encoding=UTF-8 -Duser.language=en -Duser.country=US -cp /tmp/out Codepoints
//
// A StringBuilder is a sequence of UTF-16 code units and AbstractStringBuilder
// has the same three code point reads String does: codePointAt, codePointBefore
// and codePointCount. An astral character is two units, so codePointAt(1) is
// the low half (56832) and codePointCount over the pair is one; the index
// checks are Java's, and they are not all the same exception class. Every line
// below is what the JDK printed.

class Codepoints {
  static void p(String k, Object v) {
    System.out.println(k + " = " + v);
  }
  static void caught(String k, Runnable r) {
    try {
      r.run();
      p(k, "no throw");
    } catch (Throwable t) {
      p(k, t.getClass().getName() + " msg=" + t.getMessage());
    }
  }
  public static void main(String[] args) {
    StringBuilder b = new StringBuilder("a\uD83D\uDE00b");
    p("len", b.length());
    p("cpa_0", b.codePointAt(0));
    p("cpa_1", b.codePointAt(1));
    p("cpa_2", b.codePointAt(2));
    p("cpa_3", b.codePointAt(3));
    p("cpb_1", b.codePointBefore(1));
    p("cpb_2", b.codePointBefore(2));
    p("cpb_3", b.codePointBefore(3));
    p("cpb_4", b.codePointBefore(4));
    p("cpc_0_4", b.codePointCount(0, 4));
    p("cpc_1_3", b.codePointCount(1, 3));
    p("cpc_0_1", b.codePointCount(0, 1));
    p("cpc_3_4", b.codePointCount(3, 4));
    p("cpc_0_0", b.codePointCount(0, 0));
    p("cpc_4_4", b.codePointCount(4, 4));

    caught("cpa_oob", () -> b.codePointAt(4));
    caught("cpa_neg", () -> b.codePointAt(-1));
    caught("cpb_0", () -> b.codePointBefore(0));
    caught("cpb_oob", () -> b.codePointBefore(5));
    caught("cpc_oob", () -> b.codePointCount(0, 5));
    caught("cpc_rev", () -> b.codePointCount(2, 1));
    caught("cpc_neg", () -> b.codePointCount(-1, 2));

    StringBuilder empty = new StringBuilder();
    p("empty_len", empty.length());
    p("empty_count", empty.codePointCount(0, 0));
    caught("empty_at_0", () -> empty.codePointAt(0));
    caught("empty_before_0", () -> empty.codePointBefore(0));

    // a high surrogate with nothing after it: two units, and the unit that
    // ends the buffer has no pair to be the low half of
    StringBuilder tail = new StringBuilder("x\uD83D");
    p("tail_len", tail.length());
    p("tail_cpa_0", tail.codePointAt(0));
    p("tail_cpa_1", tail.codePointAt(1));
    p("tail_cpb_1", tail.codePointBefore(1));
    p("tail_cpb_2", tail.codePointBefore(2));
    p("tail_count", tail.codePointCount(0, 2));

    StringBuffer sb = new StringBuffer("a\uD83D\uDE00b");
    p("buf_cpa_1", sb.codePointAt(1));
    p("buf_cpb_3", sb.codePointBefore(3));
    p("buf_cpc", sb.codePointCount(0, 4));
    caught("buf_cpc_oob", () -> sb.codePointCount(0, 9));
    caught("buf_cpa_oob", () -> sb.codePointAt(9));
  }
}
