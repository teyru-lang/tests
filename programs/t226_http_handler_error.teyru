import teyru.*

/* A handler that runs out of stack, and the server that has to survive it.

   A route is called reflectively, and a failure that is an Error -- a
   StackOverflowError from a handler that recursed too far is the one that
   happens -- is not an Exception. A dispatcher that catches Exception therefore
   lets it past: the client gets no answer at all, and the thread that answers
   every other client ends with it. Two requests are what it takes to say so:
   the one that overflows must be answered 500, and the one after it must be
   answered 200, because a server that answers the first and not the second is a
   server that died on the first.

   The client retries a read that timed out with nothing in hand. That is not
   slop: the collector cannot stop a thread that is inside the C library's
   recv(), and this program's client is such a thread, so a collection during
   the handler waits for the client's own read to end. The answer has not been
   written when that happens -- the handler is still running -- so a retry is
   reading from the start of the answer, and the retry is what keeps the test
   from depending on how long the pause lasts. The socket timeout is short on
   purpose: it is the pause's upper bound, not the test's patience. */

@RestController
class ErrorApi {
  @GetMapping("/ok")
  String ok() {
    return "fine"
  }

  // A recursion with work after the call, so that it is a frame per level and
  // not a loop the optimiser can collapse, and a local array so that a frame is
  // more than a pointer. The depth is far past any stack, so the number is not
  // the test's business: the StackOverflowError arrives at the limit whatever it
  // is, and every level past it is never reached.
  @GetMapping("/deep")
  String deep() {
    return "depth " + count(5000000)
  }

  public static int count(int n) {
    if (n == 0) {
      return 0
    }
    int[] frame = new int[4]
    frame[0] = n
    int r = count(n - 1)
    return r + frame[0] - n + 1
  }
}

class T226 {
  public static void main(String[] args) throws Exception {
    ApplicationContext ctx = new ApplicationContext()
    ctx.refresh()
    HttpServer server = new HttpServer(0, Application.routerFrom(ctx), ctx)
    server.bind()
    int port = server.getPort()
    ServerTask task = new ServerTask(server)
    Thread serving = new Thread(task, "server")
    serving.start()

    System.out.println("a handler that runs out of stack -> " + ask(port, "/deep"))
    System.out.println("the next request -> " + ask(port, "/ok"))

    task.stop()
    serving.join()
    server.close()
    System.out.println("done")
  }

  // ask sends one request and answers the status line, or what came instead. A
  // read that times out with nothing read is retried, for the reason in the
  // file comment; the retries are bounded so that a server which never answers
  // is a line of output rather than a program that hangs.
  static String ask(int port, String path) {
    Socket s = new Socket("127.0.0.1", port)
    s.setSoTimeout(500)
    try {
      s.getOutputStream().write("GET " + path + " HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
      s.getOutputStream().flush()
      SocketInputStream in = s.getInputStream()
      for (int attempt = 0 : attempt < 40 : attempt++) {
        try {
          String line = in.readLine()
          return line == null ? "<no answer>" : line
        } catch (SocketTimeoutException e) {
          // nothing has been read yet: the server is still in the handler
        }
      }
      return "<no answer>"
    } catch (IOException e) {
      return e.getClass().getName()
    } finally {
      s.close()
    }
  }
}
