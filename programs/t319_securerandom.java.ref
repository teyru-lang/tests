import java.security.MessageDigest;
import java.security.SecureRandom;

public class T319 {
  static void p(String s) { System.out.println(s); }

  public static void main(String[] args) {
    SecureRandom a = new SecureRandom();
    byte[] x = new byte[32];
    byte[] y = new byte[32];
    a.nextBytes(x);
    a.nextBytes(y);
    p("filled " + x.length);
    p("differs " + !MessageDigest.isEqual(x, y));

    boolean nonzero = false;
    for (byte b : x) if (b != 0) nonzero = true;
    p("not-all-zero " + nonzero);

    int inRange = 0;
    for (int i = 0; i < 200; i++) {
      int v = a.nextInt(10);
      if (v >= 0 && v < 10) inRange++;
    }
    p("in-range " + inRange);

    boolean same = true;
    for (int i = 0; i < 5; i++) {
      SecureRandom s1 = new SecureRandom();
      s1.setSeed(42L);
      SecureRandom s2 = new SecureRandom();
      s2.setSeed(42L);
      if (s1.nextLong() != s2.nextLong()) same = false;
    }
    p("same-seed-same-result " + same);

    boolean doubles = true;
    for (int i = 0; i < 100; i++) {
      double d = a.nextDouble();
      if (d < 0.0 || d >= 1.0) doubles = false;
    }
    p("double-range " + doubles);

    boolean booleans = false;
    for (int i = 0; i < 100; i++) if (a.nextBoolean()) booleans = true;
    p("boolean-value " + booleans);
  }
}
