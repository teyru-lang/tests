/* The same program as t288_interrupt.teyru, in Java. Compiled and run on
   OpenJDK 21; its output is t288_interrupt.expected. */
public class Main {
  public static void main(String[] args) {
    Thread sleeper = new Thread(new Runnable() {
      public void run() {
        try {
          Thread.sleep(10000);
          System.out.println("sleep returned normally");
        } catch (InterruptedException e) {
          System.out.println("sleep threw InterruptedException");
          System.out.println("type ok=" + (e instanceof InterruptedException));
          System.out.println("status cleared=" + (Thread.currentThread().isInterrupted() == false));
        }
      }
    }, "sleeper");
    sleeper.start();
    try {
      Thread.sleep(100);
    } catch (InterruptedException e) {
      System.out.println("main sleep interrupted");
    }
    sleeper.interrupt();
    try {
      sleeper.join();
    } catch (InterruptedException e) {
      System.out.println("join interrupted");
    }
    System.out.println("sleeper alive after join=" + sleeper.isAlive());
    System.out.println("done");
  }
}
