import teyru.*

/* A handler that recurses past the end of its stack is one failed request, not
 * one dead server.
 *
 * A route is called reflectively, so the route's frames sit under the runtime's
 * invoker: the recursion reaches the limit, the check throws, and the invoker's
 * catch frame -- the nearest one -- takes it. Java's shape for that is an
 * InvocationTargetException whose cause is the throwable, and because that
 * wrapper *is* an Exception, lib/18_web's own `catch (Exception)` takes it and
 * answers 500. So the error never reaches the connection loop and the serving
 * thread survives; that is what this pins.
 *
 * The retried read is RawClient.ask rather than this file's own loop: the
 * collector here is cooperative, so a thread blocked inside a native recv() is
 * not at a safepoint, and a client waiting for an answer is such a thread -- a
 * collection that starts while the deep request is being answered waits for the
 * client, which is waiting for the answer. The helper carries the whole of that
 * reason, including what should happen to the retry when W3.11 closes the gap;
 * this file only says which request it is making.
 * *
 * The second half is what a program cares about: the next request, on a fresh
 * connection, is answered, and the serving thread is alive at the end. See also
 * t214 (the error itself, on the main thread and on a Thread), t215/t216 (the
 * report when nothing catches it). The same shape one layer over -- a WebSocket
 * session's callbacks are called directly rather than reflectively, so an Error
 * from one does leave the loop -- is pinned separately, in t227. */

@RestController
class DeepApi {
  // A recursion no optimiser can turn into a loop: the frame's own array is read
  // after the recursive call returns, so every level keeps a frame.
  static int frameRead(int n) {
    if (n == 0) {
      return 0
    }
    int[] frame = new int[4]
    frame[0] = n
    int r = frameRead(n - 1)
    return r + frame[0] - n + 1
  }

  @GetMapping("/deep")
  String deep() {
    return "depth " + frameRead(10000000)
  }

  @GetMapping("/ok")
  String ok() {
    return "fine"
  }
}

class T241 {
  public static void main(String[] args) throws Exception {
    ApplicationContext ctx = new ApplicationContext()
    ctx.refresh()
    HttpServer server = new HttpServer(0, Application.routerFrom(ctx), ctx)
    server.bind()
    int port = server.getPort()
    ServerTask task = new ServerTask(server)
    Thread serving = new Thread(task, "server")
    serving.start()

    probe(port, "deep", "/deep")
    probe(port, "after-deep", "/ok")
    System.out.println("serving-thread-alive=" + serving.isAlive())

    task.stop()
    serving.join()
    server.close()
    System.out.println("done")
  }

  // probe asks one path on a connection of its own. The request is written out
  // here because what is being tested is the server's answer to this route, and
  // RawClient.ask is a client that takes a request rather than builds one.
  static void probe(int port, String label, String path) {
    RawClient c = new RawClient(port)
    try {
      System.out.println(label + " -> " + c.ask("GET " + path + " HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))
    } finally {
      c.close()
    }
  }
}
