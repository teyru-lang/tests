// Every permitted subtype has to be final, sealed, or non-sealed; one that is
// none of the three could grow outside the hierarchy a switch relies on.
sealed interface Shape permits Circle, Square {
  double area()
}

record Circle(double r) implements Shape {
  public double area() {
    return r
  }
}

class Square implements Shape {
  public double area() {
    return 0.0
  }
}

class Main {
  public static void main(String[] args) {
  }
}
